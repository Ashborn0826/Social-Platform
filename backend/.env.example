DATABASE_URL=postgresql+asyncpg://social:social@localhost:5432/social
REDIS_URL=redis://localhost:6379/0

# JWT — CHANGE IN PRODUCTION (use a real secret, e.g. from your secret manager)
JWT_SECRET=dev-secret-change-in-prod-please-use-a-real-secret-key
JWT_ALGORITHM=HS256

# Object storage (Phase 2)
OBJECT_STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/social-storage
S3_BUCKET=social-media
S3_ENDPOINT_URL=
S3_REGION=us-east-1

# CORS allow-list for the React frontend (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Set to true to log all SQL queries (noisy; dev only)
DEBUG=false